    var raw = (e.parameter && e.parameter.data) || (e.postData && e.postData.contents) || '{}';
    var payload = JSON.parse(raw);
    return routeAction_(payload);
  } catch (err) {
    return { success: false, message: 'Invalid payload: ' + err.message };
  }
}

function _respond(obj) {
