/**
 * REFERENSI HANDLER GAS — copy-paste ke Apps Script Anda untuk
 * memperbaiki isu yang muncul di frontend:
 *
 *   1) "Action tidak dikenali: addUser / updateUser / setUserStatus / resetPin"
 *      → Router doGet/doPost di GAS Anda belum punya cabang untuk action-action
 *        baru (tab Karyawan butuh CRUD penuh). Disertakan di bawah.
 *   2) "Belum ada data leaderboard. Backend perlu support action getDashboardStats."
 *      → Frontend SEKARANG sudah menghitung leaderboard sendiri sebagai
 *        fallback, jadi handler `getDashboardStats` BERSIFAT OPSIONAL.
 *        Disertakan di sini supaya admin yang ingin angkanya akurat
 *        (memperhitungkan izin/cuti, dsb.) bisa override fallback.
 *
 * CARA PASANG:
 *   1) Buka script Apps Script Anda (Tools → Script editor di Sheets).
 *   2) Tambahkan/merge fungsi-fungsi di bawah ke Code.gs Anda.
 *   3) Pastikan router `doGet` / `doPost` (atau `handleRequest`) sudah
 *      meneruskan action `addUser`, `updateUser`, `setUserStatus`, `resetPin`,
 *      dan `getDashboardStats` ke handler yang sesuai (lihat contoh
 *      `routeAction_` paling bawah).
 *   4) Klik Run → pilih `addUser` (sekali saja) → di dialog otorisasi Google,
 *      **berikan izin Spreadsheet**. Untuk `resetPin` tambahan: izin **Gmail/MailApp**.
 *      Tanpa langkah ini, handler akan crash di runtime.
 *   5) Deploy ulang Web App (Deploy → Manage Deployments → Edit → New version).
 *
 * SCRIPT PROPERTIES yang dibaca:
 *   - JAM_MASUK    (default "08:15")
 *   - TOLERANSI_MENIT (default 45)
 *
 * Set via: File → Project properties → Script properties.
 */


/* ════════════════════════════════════════════════════════
   1) addUser — dipanggil dari modal "Tambah Karyawan"
   ════════════════════════════════════════════════════════ */
function addUser(p) {
  try {
    var idKar    = String(p.id_karyawan || '').trim();
    var nama     = String(p.nama || '').trim();
    var email    = String(p.email || '').trim();
    var noHp     = String(p.no_hp || '').trim();
    var jabatan  = String(p.jabatan || '').trim();
    var tglMasuk = String(p.tanggal_masuk || '').trim();
    var role     = String(p.role || 'Karyawan').trim();
    var pin      = String(p.pin || '').trim();

    if (!idKar || !nama) {
      return { success: false, message: 'ID Karyawan dan Nama wajib diisi.' };
    }
    if (!pin || !/^\d{4,6}$/.test(pin)) {
      return { success: false, message: 'PIN default harus 4-6 digit angka.' };
    }

    var sh = SpreadsheetApp.getActive().getSheetByName('Users');
    if (!sh) return { success: false, message: 'Sheet Users tidak ditemukan.' };

    var ctx = _readUsersSheet_(sh);
    // Cek duplikat ID
    for (var i = 1; i < ctx.values.length; i++) {
      if (String(ctx.values[i][ctx.idx.id_karyawan]).trim() === idKar) {
        return { success: false, message: 'ID "' + idKar + '" sudah terdaftar.' };
      }
    }

    // Bangun row baru sesuai urutan kolom sheet
    var row = new Array(ctx.header.length).fill('');
    _setCol_(row, ctx.idx, 'id_karyawan',   idKar);
    _setCol_(row, ctx.idx, 'nama',          nama);
    _setCol_(row, ctx.idx, 'pin',           pin);            // ⚠ Plaintext. Untuk produksi sebaiknya hash.
    _setCol_(row, ctx.idx, 'role',          role || 'Karyawan');
    _setCol_(row, ctx.idx, 'email',         email);
    _setCol_(row, ctx.idx, 'no_hp',         noHp);
    _setCol_(row, ctx.idx, 'jabatan',       jabatan);
    _setCol_(row, ctx.idx, 'tanggal_masuk', tglMasuk);
    _setCol_(row, ctx.idx, 'status',        'active');
    sh.appendRow(row);

    return { success: true, message: 'Karyawan ditambahkan.' };
  } catch (e) {
    return { success: false, message: 'Gagal: ' + (e && e.message ? e.message : e) };
  }
}


/* ════════════════════════════════════════════════════════
   2) updateUser — dipanggil dari modal "Edit Karyawan"
   ════════════════════════════════════════════════════════ */
function updateUser(p) {
  try {
    var idKar = String(p.id_karyawan || '').trim();
    if (!idKar) return { success: false, message: 'ID Karyawan wajib diisi.' };

    var sh = SpreadsheetApp.getActive().getSheetByName('Users');
    if (!sh) return { success: false, message: 'Sheet Users tidak ditemukan.' };

    var ctx = _readUsersSheet_(sh);
    var rowNum = -1;
    for (var i = 1; i < ctx.values.length; i++) {
      if (String(ctx.values[i][ctx.idx.id_karyawan]).trim() === idKar) {
        rowNum = i + 1;          // sheet rows are 1-based
        break;
      }
    }
    if (rowNum < 0) return { success: false, message: 'Karyawan "' + idKar + '" tidak ditemukan.' };

    // Update field yang dikirim (yang tidak ada di payload diabaikan, tidak di-overwrite)
    var updates = {
      nama          : 'nama',
      email         : 'email',
      no_hp         : 'no_hp',
      jabatan       : 'jabatan',
      tanggal_masuk : 'tanggal_masuk',
      role          : 'role',
    };
    Object.keys(updates).forEach(function (k) {
      if (p[k] !== undefined && p[k] !== null) {
        var col = ctx.idx[updates[k]];
        if (col >= 0) sh.getRange(rowNum, col + 1).setValue(p[k]);
      }
    });

    // PIN opsional: hanya di-update kalau dikirim
    if (p.pin && /^\d{4,6}$/.test(String(p.pin))) {
      var pinCol = ctx.idx.pin;
      if (pinCol >= 0) sh.getRange(rowNum, pinCol + 1).setValue(String(p.pin));
    }

    return { success: true, message: 'Data karyawan diperbarui.' };
  } catch (e) {
    return { success: false, message: 'Gagal: ' + (e && e.message ? e.message : e) };
  }
}


/* ════════════════════════════════════════════════════════
   3) setUserStatus — soft delete / aktifkan kembali
   ════════════════════════════════════════════════════════ */
function setUserStatus(p) {
  try {
    var idKar = String(p.id_karyawan || '').trim();
    var st    = String(p.status || '').toLowerCase();
    if (!idKar)                            return { success: false, message: 'ID Karyawan wajib diisi.' };
    if (st !== 'active' && st !== 'inactive') return { success: false, message: 'Status harus "active" atau "inactive".' };

    var sh = SpreadsheetApp.getActive().getSheetByName('Users');
    if (!sh) return { success: false, message: 'Sheet Users tidak ditemukan.' };

    var ctx = _readUsersSheet_(sh);
    var statusCol = ctx.idx.status;
    if (statusCol < 0) return { success: false, message: 'Kolom status tidak ada di sheet Users.' };

    for (var i = 1; i < ctx.values.length; i++) {
      if (String(ctx.values[i][ctx.idx.id_karyawan]).trim() === idKar) {
        sh.getRange(i + 1, statusCol + 1).setValue(st);
        return { success: true, message: st === 'inactive' ? 'Karyawan dinonaktifkan.' : 'Karyawan diaktifkan.' };
      }
    }
    return { success: false, message: 'Karyawan "' + idKar + '" tidak ditemukan.' };
  } catch (e) {
    return { success: false, message: 'Gagal: ' + (e && e.message ? e.message : e) };
  }
}


/* ════════════════════════════════════════════════════════
   4) resetPin — generate PIN acak + (opsional) kirim email
   ════════════════════════════════════════════════════════ */
function resetPin(p) {
  try {
    var idKar = String(p.id_karyawan || '').trim();
    if (!idKar) return { success: false, message: 'ID Karyawan wajib diisi.' };

    var sh = SpreadsheetApp.getActive().getSheetByName('Users');
    if (!sh) return { success: false, message: 'Sheet Users tidak ditemukan.' };

    var ctx = _readUsersSheet_(sh);
    var rowNum = -1, namaUser = idKar, emailUser = '';
    for (var i = 1; i < ctx.values.length; i++) {
      if (String(ctx.values[i][ctx.idx.id_karyawan]).trim() === idKar) {
        rowNum = i + 1;
        namaUser  = ctx.values[i][ctx.idx.nama]  || idKar;
        emailUser = ctx.values[i][ctx.idx.email] || '';
        break;
      }
    }
    if (rowNum < 0) return { success: false, message: 'Karyawan "' + idKar + '" tidak ditemukan.' };

    var newPin = String(Math.floor(100000 + Math.random() * 900000));
    sh.getRange(rowNum, ctx.idx.pin + 1).setValue(newPin);

    // Coba kirim email — jika MailApp belum di-authorize, jangan crash.
    var sentEmail = false;
    if (emailUser) {
      try {
        MailApp.sendEmail({
          to: emailUser,
          subject: 'PIN Absensi FSR Anda Telah Direset',
          body:
            'Halo ' + namaUser + ',\n\n' +
            'PIN Absensi FSR Anda telah direset oleh admin.\n' +
            'PIN baru: ' + newPin + '\n\n' +
            'Mohon segera login dan ubah PIN Anda jika perlu.',
        });
        sentEmail = true;
      } catch (mailErr) { /* abaikan */ }
    }

    return {
      success: true,
      message: sentEmail ? 'PIN direset dan dikirim ke email.' : 'PIN direset. Silakan informasikan ke karyawan.',
      new_pin: newPin,
    };
  } catch (e) {
    return { success: false, message: 'Gagal: ' + (e && e.message ? e.message : e) };
  }
}


/* ════════════════════════════════════════════════════════
   5) getUsers — kembalikan daftar karyawan dengan key yang konsisten

   Frontend membaca field dengan nama lowercase: id_karyawan, nama, email,
   no_hp, jabatan, tanggal_masuk, role, status. Pastikan handler ini
   mengembalikan SEMUA field tersebut walau header sheet pakai huruf besar
   atau ada spasi. Helper _readUsersSheet_ sudah handle case-insensitive.
   ════════════════════════════════════════════════════════ */
function getUsers() {
  try {
    var sh = SpreadsheetApp.getActive().getSheetByName('Users');
    if (!sh) return { success: false, message: 'Sheet Users tidak ditemukan.' };

    var ctx = _readUsersSheet_(sh);
    var tz  = Session.getScriptTimeZone() || 'Asia/Jakarta';

    var users = [];
    for (var i = 1; i < ctx.values.length; i++) {
      var row = ctx.values[i];
      var idK = row[ctx.idx.id_karyawan];
      if (!idK) continue;

      // Tanggal_masuk: kalau cell-nya Date object, format ke YYYY-MM-DD;
      // kalau sudah string, biarkan apa adanya (frontend juga toleran).
      var tglRaw = ctx.idx.tanggal_masuk >= 0 ? row[ctx.idx.tanggal_masuk] : '';
      var tglStr = '';
      if (tglRaw instanceof Date) {
        tglStr = Utilities.formatDate(tglRaw, tz, 'yyyy-MM-dd');
      } else if (tglRaw) {
        tglStr = String(tglRaw);
      }

      users.push({
        id_karyawan   : String(idK),
        nama          : String(row[ctx.idx.nama] || ''),
        email         : ctx.idx.email   >= 0 ? String(row[ctx.idx.email]   || '') : '',
        no_hp         : ctx.idx.no_hp   >= 0 ? String(row[ctx.idx.no_hp]   || '') : '',
        jabatan       : ctx.idx.jabatan >= 0 ? String(row[ctx.idx.jabatan] || '') : '',
        tanggal_masuk : tglStr,
        role          : ctx.idx.role    >= 0 ? String(row[ctx.idx.role]    || 'Karyawan') : 'Karyawan',
        status        : ctx.idx.status  >= 0 ? String(row[ctx.idx.status]  || 'active').toLowerCase() : 'active',
      });
    }
    return { success: true, users: users };
  } catch (e) {
    return { success: false, message: 'Gagal: ' + (e && e.message ? e.message : e) };
  }
}


/* ════════════════════════════════════════════════════════
   Helper sheet Users — pakai header lowercase secara konsisten
   ════════════════════════════════════════════════════════ */
function _readUsersSheet_(sh) {
  var values = sh.getDataRange().getValues();
  var header = (values[0] || []).map(function (h) { return String(h).trim().toLowerCase(); });
  var idx = {
    id_karyawan   : header.indexOf('id_karyawan'),
    nama          : header.indexOf('nama'),
    pin           : header.indexOf('pin'),
    role          : header.indexOf('role'),
    email         : header.indexOf('email'),
    no_hp         : header.indexOf('no_hp'),
    jabatan       : header.indexOf('jabatan'),
    tanggal_masuk : header.indexOf('tanggal_masuk'),
    status        : header.indexOf('status'),
  };
  return { values: values, header: header, idx: idx };
}

function _setCol_(row, idx, key, val) {
  if (idx[key] >= 0) row[idx[key]] = val;
}


/* ════════════════════════════════════════════════════════
   2) getDashboardStats — opsional, fallback frontend sudah ada
   ════════════════════════════════════════════════════════ */
function getDashboardStats() {
  try {
    var ss = SpreadsheetApp.getActive();
    var usersSh   = ss.getSheetByName('Users');
    var absensiSh = ss.getSheetByName('Absensi');
    if (!usersSh || !absensiSh) {
      return { success: false, message: 'Sheet Users / Absensi tidak ditemukan.' };
    }

    var props = PropertiesService.getScriptProperties();
    var jamMasukStr = props.getProperty('JAM_MASUK') || '08:15';
    var toleransi   = parseInt(props.getProperty('TOLERANSI_MENIT') || '45', 10);
    var jamParts    = jamMasukStr.split(':');
    var jamMasukMin = parseInt(jamParts[0], 10) * 60 + parseInt(jamParts[1], 10);
    var batasTelat  = jamMasukMin + toleransi;

    // Load users (filter status active)
    var uVals = usersSh.getDataRange().getValues();
    var uHead = uVals[0].map(function (h) { return String(h).trim().toLowerCase(); });
    var uIdxId     = uHead.indexOf('id_karyawan');
    var uIdxNama   = uHead.indexOf('nama');
    var uIdxStatus = uHead.indexOf('status');
    var users = [];
    for (var i = 1; i < uVals.length; i++) {
      var r = uVals[i];
      var status = uIdxStatus >= 0 ? String(r[uIdxStatus] || 'active').toLowerCase() : 'active';
      if (status === 'inactive') continue;
      users.push({ id: String(r[uIdxId]), nama: r[uIdxNama] });
    }
    var totalKaryawan = users.length;
    var namaById = {};
    users.forEach(function (u) { namaById[u.id] = u.nama; });

    // Load absensi (semua, lalu filter di JS)
    var aVals = absensiSh.getDataRange().getValues();
    var aHead = aVals[0].map(function (h) { return String(h).trim().toLowerCase(); });
    var aIdxTs   = aHead.indexOf('timestamp');
    var aIdxId   = aHead.indexOf('id_karyawan');
    var aIdxTipe = aHead.indexOf('tipe_absen');

    var tz = Session.getScriptTimeZone() || 'Asia/Jakarta';
    var todayStr = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
    var monthPrefix = todayStr.substring(0, 7); // "yyyy-MM"

    var dayCount = {};            // { 'yyyy-MM-dd': { hadir:Set, telat:n } }
    var monthTepat = {};          // { id_karyawan: count }
    var hadirHariIni = new Set(), telatHariIniSet = new Set();

    for (var j = 1; j < aVals.length; j++) {
      var rec = aVals[j];
      var tsRaw = rec[aIdxTs];
      var tsStr = (tsRaw instanceof Date)
        ? Utilities.formatDate(tsRaw, tz, 'yyyy-MM-dd HH:mm:ss')
        : String(tsRaw || '');
      if (tsStr.length < 19) continue;

      var dateStr = tsStr.substring(0, 10);
      var hh = parseInt(tsStr.substring(11, 13), 10);
      var mm = parseInt(tsStr.substring(14, 16), 10);
      if (isNaN(hh) || isNaN(mm)) continue;
      var ciMin = hh * 60 + mm;

      var idK = String(rec[aIdxId] || '');
      var tipe = String(rec[aIdxTipe] || '');
      if (tipe !== 'Check-In') continue;

      // Aggregate per hari (untuk weekly chart)
      if (!dayCount[dateStr]) dayCount[dateStr] = { hadirSet: {}, telat: 0 };
      dayCount[dateStr].hadirSet[idK] = true;
      var isTelat = ciMin > batasTelat;
      if (isTelat) dayCount[dateStr].telat++;

      // Today
      if (dateStr === todayStr) {
        hadirHariIni.add(idK);
        if (isTelat) telatHariIniSet.add(idK);
      }
      // Bulan berjalan: count tepat waktu
      if (!isTelat && dateStr.substring(0, 7) === monthPrefix) {
        monthTepat[idK] = (monthTepat[idK] || 0) + 1;
      }
    }

    var hadirHariIniCount = hadirHariIni.size;
    var telatHariIniCount = telatHariIniSet.size;

    // Weekly (7 hari terakhir)
    var weekly = [];
    var dayNames = ['Min','Sen','Sel','Rab','Kam','Jum','Sab'];
    var todayDate = new Date();
    for (var k = 6; k >= 0; k--) {
      var d = new Date(todayDate);
      d.setDate(d.getDate() - k);
      var ds = Utilities.formatDate(d, tz, 'yyyy-MM-dd');
      var bucket = dayCount[ds] || { hadirSet: {}, telat: 0 };
      var hadirKeys = Object.keys(bucket.hadirSet);
      var hadirCnt = Math.max(0, hadirKeys.length - bucket.telat);
      var dow = d.getDay();
      var isWeekend = (dow === 0 || dow === 6);
      var alpa = isWeekend ? 0 : Math.max(0, totalKaryawan - hadirKeys.length);
      weekly.push({
        date: ds, label: dayNames[dow],
        hadir: hadirCnt, telat: bucket.telat, alpa: alpa,
      });
    }

    // Leaderboard top 5
    var leaderboard = Object.keys(monthTepat)
      .map(function (id) { return { id_karyawan: id, nama: namaById[id] || id, tepat_waktu: monthTepat[id] }; })
      .sort(function (a, b) { return b.tepat_waktu - a.tepat_waktu; })
      .slice(0, 5);

    return {
      success: true,
      stats: {
        totalKaryawan: totalKaryawan,
        hadirHariIni: hadirHariIniCount,
        telatHariIni: telatHariIniCount,
        tidakHadir: Math.max(0, totalKaryawan - hadirHariIniCount),
        weekly: weekly,
        leaderboard: leaderboard,
      },
    };
  } catch (e) {
    return { success: false, message: 'Gagal: ' + (e && e.message ? e.message : e) };
  }
}


/* ════════════════════════════════════════════════════════
   Contoh router untuk doGet / doPost
   ════════════════════════════════════════════════════════ */
function routeAction_(payload) {
  var action = payload && payload.action;
  switch (action) {
    case 'addUser':           return addUser(payload);
    case 'updateUser':        return updateUser(payload);
    case 'setUserStatus':     return setUserStatus(payload);
    case 'resetPin':          return resetPin(payload);
    case 'getUsers':          return getUsers();
    case 'getDashboardStats': return getDashboardStats();
    // ... action lain yang sudah Anda punya:
    // case 'login':            return login(payload);
    // case 'submitAbsensi':    return submitAbsensi(payload);
    // case 'getAbsensiRange':  return getAbsensiRange(payload);
    // case 'getMyTodayStatus': return getMyTodayStatus(payload);
    // case 'getMyMonthly':     return getMyMonthly(payload);
    // case 'submitIzin':       return submitIzin(payload);
    // case 'getMyIzin':        return getMyIzin(payload);
    // case 'getAllIzin':       return getAllIzin();
    // case 'updateIzinStatus': return updateIzinStatus(payload);
    default:
      return { success: false, message: 'Action tidak dikenali: "' + action + '"' };
  }
}

/* Contoh doGet/doPost — sesuaikan dengan punya Anda */
