/**
 * ============================================================
 *  ABSENSI FSR — Google Apps Script Backend (REST API)
 *  Version : 3.0.0 — Full CRUD Edition
 * ============================================================
 *
 *  ⚠ CARA INSTAL — GANTI SELURUH ISI Code.gs ANDA DENGAN FILE INI.
 *
 *  Kalau di Code.gs lama Anda sudah ada `handleRequest`, `handleLogin`,
 *  `handleSubmitAbsensi`, dst. — JANGAN DI-MERGE manual. Cukup:
 *    1) Buka Apps Script editor (Extensions → Apps Script di Spreadsheet).
 *    2) Hapus semua isi Code.gs.
 *    3) Copy-paste seluruh isi file ini.
 *    4) Update CONFIG di bawah (SPREADSHEET_ID, SELFIE_FOLDER_ID).
 *    5) Klik Run pada fungsi `handleAddUser` SEKALI saja → akan muncul
 *       dialog "Authorization required" → Review permissions → Advanced
 *       → Go to {project} (unsafe) → Allow. Ulangi untuk `handleResetPin`
 *       (perlu izin MailApp tambahan).
 *    6) Deploy → Manage Deployments → Edit (ikon pensil) → Version: New
 *       version → Deploy. Pastikan: Execute as = Me, Who has access = Anyone.
 *
 *  WHAT'S NEW IN v3.0
 *  ─────────────────────────────────────────────────────────
 *  - addUser, updateUser, setUserStatus, resetPin (full CRUD karyawan)
 *    Sebelumnya tidak ada di router → menyebabkan "Action tidak dikenali".
 *  - getAbsensiRange (untuk fitur "Laporan Bulan Ini")
 *  - getDashboardStats (KPI + leaderboard, opsional)
 *  - handleGetUsers diperluas: return email, no_hp, jabatan,
 *    tanggal_masuk, status (untuk frontend admin tab Karyawan).
 *  - handleLogin sekarang reject user dengan status='inactive'.
 *  - Auto-add kolom Email/No_HP/Jabatan/Tanggal_Masuk/Status ke
 *    sheet Users kalau belum ada (saat addUser/updateUser pertama kali).
 *  - Header sheet matched secara case+format insensitive ("ID_Karyawan"
 *    sama dengan "id_karyawan" sama dengan "ID Karyawan").
 *
 *  SHEETS — Pastikan ini ada (kolom akan auto-extend bila perlu):
 *    "Users"   : ID_Karyawan | Nama | PIN | Role
 *                (+ Email | No_HP | Jabatan | Tanggal_Masuk | Status —
 *                 auto-added saat addUser/updateUser pertama kali)
 *    "Absensi" : Timestamp | ID_Karyawan | Nama | Tipe_Absen |
 *                Latitude | Longitude | Link_Google_Maps |
 *                Selfie_URL | In_Radius | Distance_M | Status
 *    "Izin"    : Timestamp | ID_Karyawan | Nama | Tipe | Dari | Sampai |
 *                Alasan | Status | Approved_By | Approved_At
 * ============================================================
 */

// ════════════════════════════════════════════════════════════
//  CONFIG — UPDATE NILAI INI
// ════════════════════════════════════════════════════════════

const SPREADSHEET_ID    = 'PASTE_SPREADSHEET_ID_DI_SINI';
const SELFIE_FOLDER_ID  = 'PASTE_DRIVE_FOLDER_ID_DI_SINI';
const TZ                = 'Asia/Jakarta';

const JAM_MASUK_HHMM    = '08:15';
const JAM_PULANG_HHMM   = '17:00';
const TOLERANSI_MENIT   = 45;

// ════════════════════════════════════════════════════════════
//  ENTRY POINTS + ROUTER
// ════════════════════════════════════════════════════════════

function doGet(e)  { return handleRequest(e); }
function doPost(e) { return handleRequest(e); }

function handleRequest(e) {
  try {
    var params = {};

    if (e.postData && e.postData.contents) {
      try { params = JSON.parse(e.postData.contents); } catch (_) {}
    }
    if (e.parameter && e.parameter.data) {
      try {
        var decoded = JSON.parse(decodeURIComponent(e.parameter.data));
        params = Object.assign(params, decoded);
      } catch (_) {}
    }
    if (e.parameter) {
      Object.keys(e.parameter).forEach(function (k) {
        if (k !== 'data' && !params[k]) params[k] = e.parameter[k];
      });
    }

    var action = params.action || '';

    switch (action) {
      // ── v1 actions ─────────────────────────
      case 'login':             return respond(handleLogin(params));
      case 'submitAbsensi':     return respond(handleSubmitAbsensi(params));
      case 'getUsers':          return respond(handleGetUsers(params));
      case 'updateUserRole':    return respond(handleUpdateUserRole(params));
      case 'getTodayAbsensi':   return respond(handleGetTodayAbsensi(params));

      // ── v2 actions ─────────────────────────
      case 'getMyTodayStatus':  return respond(handleGetMyTodayStatus(params));
      case 'getMyMonthly':      return respond(handleGetMyMonthly(params));
      case 'submitIzin':        return respond(handleSubmitIzin(params));
      case 'getMyIzin':         return respond(handleGetMyIzin(params));
      case 'getAllIzin':        return respond(handleGetAllIzin(params));
      case 'updateIzinStatus':  return respond(handleUpdateIzinStatus(params));

      // ── v3 NEW actions ────────────────────
      case 'addUser':           return respond(handleAddUser(params));
      case 'updateUser':        return respond(handleUpdateUser(params));
      case 'setUserStatus':     return respond(handleSetUserStatus(params));
      case 'resetPin':          return respond(handleResetPin(params));
      case 'getAbsensiRange':   return respond(handleGetAbsensiRange(params));
      case 'getDashboardStats': return respond(handleGetDashboardStats(params));

      case 'ping':              return respond({ success: true, message: 'pong', serverTime: nowWIB(), version: '3.0.0' });

      default:
        return respond({ success: false, message: 'Action tidak dikenali: "' + action + '"' });
    }
  } catch (err) {
    return respond({ success: false, message: 'Server error: ' + (err && err.message ? err.message : err) });
  }
}

// ════════════════════════════════════════════════════════════
//  UTILITIES
// ════════════════════════════════════════════════════════════

function respond(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

function getSheet(name) {
  var ss    = SpreadsheetApp.openById(SPREADSHEET_ID);
  var sheet = ss.getSheetByName(name);
  if (!sheet) throw new Error('Sheet "' + name + '" tidak ditemukan.');
  return sheet;
}

function todayWIB() { return Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd'); }
function nowWIB()   { return Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd HH:mm:ss'); }
function str(val)   { return String(val == null ? '' : val).trim(); }

function computeStatus(checkinTime, checkoutTime) {
  if (!checkinTime) return '';
  var ciP = checkinTime.split(':');
  var ciMin = (+ciP[0]) * 60 + (+ciP[1]);
  var jm = JAM_MASUK_HHMM.split(':');
  var jp = JAM_PULANG_HHMM.split(':');
  var batasMasuk  = (+jm[0]) * 60 + (+jm[1]);
  var batasPulang = (+jp[0]) * 60 + (+jp[1]);
  var batasTelat  = batasMasuk + TOLERANSI_MENIT;

  var status = 'Tepat Waktu';
  if (ciMin > batasTelat) status = 'Telat ' + (ciMin - batasMasuk) + ' menit';

  if (checkoutTime) {
    var coP = checkoutTime.split(':');
    var coMin = (+coP[0]) * 60 + (+coP[1]);
    if (coMin > batasPulang + 30) {
      var lembur = coMin - batasPulang;
      var jam = Math.floor(lembur / 60);
      var menit = lembur % 60;
      status = jam > 0 ? ('Lembur ' + jam + 'j ' + menit + 'm') : ('Lembur ' + menit + 'm');
    }
  }
  return status;
}

function saveSelfieToDrive(base64DataUrl, idKaryawan, tipe) {
  if (!SELFIE_FOLDER_ID || !base64DataUrl) return '';
  try {
    var match = base64DataUrl.match(/^data:(image\/\w+);base64,(.+)$/);
    if (!match) return '';
    var bytes = Utilities.base64Decode(match[2]);
    var blob = Utilities.newBlob(bytes, match[1],
      idKaryawan + '_' + tipe.replace('-', '') + '_' + nowWIB().replace(/[: ]/g, '-') + '.jpg');
    var folder = DriveApp.getFolderById(SELFIE_FOLDER_ID);
    var file = folder.createFile(blob);

    // Ambil URL DULU sebelum setSharing — supaya kalau setSharing throw
    // (umum terjadi di akun Google Workspace yang admin batasi sharing
    // publik), URL tetap tersimpan ke sheet. File sudah ada di Drive,
    // admin tinggal atur sharing folder sekali (Anyone with link → Viewer)
    // supaya thumbnail bisa muncul di tabel.
    var fileUrl = file.getUrl();

    try {
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    } catch (sharingErr) {
      console.warn('Selfie sharing gagal (URL tetap disimpan ke sheet):', sharingErr);
    }

    return fileUrl;
  } catch (err) {
    console.error('Selfie save failed:', err);
    return '';
  }
}

// ════════════════════════════════════════════════════════════
//  BACKFILL: isi ulang Selfie_URL untuk record lama yang kosong
//  Cara pakai: di Apps Script editor, pilih fungsi `backfillSelfieUrls`
//  dari dropdown lalu klik Run. Akan men-scan folder Drive selfie &
//  mencocokkan ke baris Absensi berdasarkan ID_Karyawan + Tipe + Timestamp.
//
//  Format nama file (yang dibuat oleh saveSelfieToDrive):
//    {id}_{tipe}_{yyyy-MM-dd-HH-mm-ss}.jpg
//    contoh: 10155_CheckIn_2026-05-28-15-22-46.jpg
// ════════════════════════════════════════════════════════════

function backfillSelfieUrls() {
  if (!SELFIE_FOLDER_ID) {
    console.error('SELFIE_FOLDER_ID belum diisi.');
    return;
  }

  var sheet = getSheet('Absensi');
  var data  = sheet.getDataRange().getValues();
  if (data.length < 2) { console.log('Sheet Absensi kosong.'); return; }

  // Index baris berdasarkan kunci: id|tipe|yyyy-MM-dd-HH-mm-ss
  var rowIndex = {};
  for (var i = 1; i < data.length; i++) {
    var raw = data[i][0];
    if (!raw) continue;
    var ts = (raw instanceof Date)
      ? Utilities.formatDate(raw, TZ, 'yyyy-MM-dd-HH-mm-ss')
      : String(raw).replace(' ', '-').replace(/:/g, '-').substring(0, 19);
    var id = String(data[i][1] || '').trim();
    var tipe = String(data[i][3] || '').replace('-', ''); // "Check-In" → "CheckIn"
    var key = id + '|' + tipe + '|' + ts;
    rowIndex[key] = i + 1; // simpan nomor baris (1-based)
  }

  var folder = DriveApp.getFolderById(SELFIE_FOLDER_ID);
  var files = folder.getFiles();
  var updated = 0, skipped = 0, notMatched = 0;

  while (files.hasNext()) {
    var file = files.next();
    var name = file.getName(); // mis. "10155_CheckIn_2026-05-28-15-22-46.jpg"
    var m = name.match(/^(.+?)_(CheckIn|CheckOut)_(\d{4}-\d{2}-\d{2}-\d{2}-\d{2}-\d{2})\.(jpg|jpeg|png|webp)$/i);
    if (!m) { skipped++; continue; }

    var id = m[1], tipe = m[2], ts = m[3];
    // Coba match exact dulu; kalau gagal, toleransi ±2 detik (timestamp
    // di sheet dibuat sedetik setelah file di-create).
    var rowNum = rowIndex[id + '|' + tipe + '|' + ts] || 0;
    if (!rowNum) {
      var p = ts.split('-'); // [Y,M,D,H,m,s]
      var base = new Date(p[0], +p[1]-1, +p[2], +p[3], +p[4], +p[5]);
      for (var dt = -2; dt <= 2 && !rowNum; dt++) {
        if (dt === 0) continue;
        var d2 = new Date(base.getTime() + dt * 1000);
        var ts2 = Utilities.formatDate(d2, TZ, 'yyyy-MM-dd-HH-mm-ss');
        rowNum = rowIndex[id + '|' + tipe + '|' + ts2] || 0;
      }
    }

    if (!rowNum) { notMatched++; continue; }

    // Skip kalau cell Selfie_URL sudah terisi.
    var existing = String(sheet.getRange(rowNum, 8).getValue() || '').trim();
    if (existing) { skipped++; continue; }

    var url = file.getUrl();
    try {
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    } catch (e) { /* abaikan, URL tetap diisi */ }

    sheet.getRange(rowNum, 8).setValue(url);
    updated++;
  }

  console.log('Backfill selesai: ' + updated + ' record diisi, ' + skipped +
    ' di-skip (sudah ada / format file tidak dikenal), ' + notMatched + ' tidak match.');
  return { updated: updated, skipped: skipped, notMatched: notMatched };
}

// ── Helper: case+format insensitive header detection untuk sheet Users ──
// Match "ID_Karyawan", "id_karyawan", "ID Karyawan", "idkaryawan" semuanya.
function _readUsersSheet_(sh) {
  var values    = sh.getDataRange().getValues();
  var rawHeader = values[0] || [];
  var norm      = function (s) { return String(s).toLowerCase().replace(/[^a-z0-9]/g, ''); };
  var normedHeader = rawHeader.map(norm);

  function findCol(keys) {
    for (var k = 0; k < keys.length; k++) {
      var i = normedHeader.indexOf(norm(keys[k]));
      if (i >= 0) return i;
    }
    return -1;
  }

  var idx = {
    id_karyawan   : findCol(['id_karyawan', 'idkaryawan', 'id']),
    nama          : findCol(['nama', 'name']),
    pin           : findCol(['pin', 'password']),
    role          : findCol(['role']),
    email         : findCol(['email', 'mail']),
    no_hp         : findCol(['no_hp', 'nohp', 'phone', 'telepon', 'whatsapp', 'wa']),
    jabatan       : findCol(['jabatan', 'position', 'posisi', 'job_title']),
    tanggal_masuk : findCol(['tanggal_masuk', 'tanggalmasuk', 'tgl_masuk', 'tglmasuk', 'join_date', 'mulai_kerja']),
    status        : findCol(['status', 'aktif', 'active']),
  };
  return { values: values, rawHeader: rawHeader, idx: idx };
}

// ── Helper: auto-add kolom yang kurang (Email, No_HP, Jabatan, Tanggal_Masuk, Status) ──
function _ensureUsersColumns_(sh) {
  var ctx = _readUsersSheet_(sh);
  var needed = [
    { key: 'email',         label: 'Email' },
    { key: 'no_hp',         label: 'No_HP' },
    { key: 'jabatan',       label: 'Jabatan' },
    { key: 'tanggal_masuk', label: 'Tanggal_Masuk' },
    { key: 'status',        label: 'Status' },
  ];
  var lastCol = sh.getLastColumn();
  needed.forEach(function (item) {
    if (ctx.idx[item.key] < 0) {
      lastCol++;
      sh.getRange(1, lastCol).setValue(item.label);
    }
  });
}

function _setCol_(row, idx, key, val) {
  if (idx[key] >= 0) row[idx[key]] = val;
}

// ════════════════════════════════════════════════════════════
//  HANDLER: LOGIN  (rejects inactive users)
// ════════════════════════════════════════════════════════════

function handleLogin(params) {
  var id  = str(params.id_karyawan);
  var pin = str(params.pin);

  if (!id || !pin) {
    return { success: false, message: 'ID Karyawan dan PIN wajib diisi.' };
  }

  var sh = getSheet('Users');
  var ctx = _readUsersSheet_(sh);

  for (var i = 1; i < ctx.values.length; i++) {
    var row = ctx.values[i];
    var rowId  = ctx.idx.id_karyawan >= 0 ? str(row[ctx.idx.id_karyawan]) : str(row[0]);
    var rowPin = ctx.idx.pin         >= 0 ? str(row[ctx.idx.pin])         : str(row[2]);
    if (!rowId) continue;
    if (rowId !== id || rowPin !== pin) continue;

    // Cek status — kalau inactive, tolak login
    var status = ctx.idx.status >= 0 ? str(row[ctx.idx.status]).toLowerCase() : 'active';
    if (status === 'inactive') {
      return { success: false, message: 'Akun Anda dinonaktifkan. Hubungi admin.' };
    }

    return {
      success: true,
      user: {
        id_karyawan : rowId,
        nama        : ctx.idx.nama >= 0 ? str(row[ctx.idx.nama]) : str(row[1]),
        role        : (function () {
          var raw = ctx.idx.role >= 0 ? str(row[ctx.idx.role]) : str(row[3]);
          return raw.toLowerCase() === 'admin' ? 'Admin' : 'Karyawan';
        })(),
      },
    };
  }
  return { success: false, message: 'ID Karyawan atau PIN tidak valid. Silakan coba lagi.' };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: SUBMIT ABSENSI (selfie + geofence + status)
// ════════════════════════════════════════════════════════════

function handleSubmitAbsensi(params) {
  var id        = str(params.id_karyawan);
  var nama      = str(params.nama);
  var tipe      = str(params.tipe_absen);
  var latitude  = str(params.latitude);
  var longitude = str(params.longitude);
  var selfie    = str(params.selfie);
  var inRadius  = params.in_radius === true || params.in_radius === 'true' ? 'YA'
                : (params.in_radius === false || params.in_radius === 'false') ? 'TIDAK' : '';
  var distance  = params.distance != null ? str(params.distance) : '';

  if (!id || !nama || !tipe) return { success: false, message: 'Data absensi tidak lengkap.' };
  if (tipe !== 'Check-In' && tipe !== 'Check-Out') return { success: false, message: 'Tipe absen tidak valid.' };

  var sheet = getSheet('Absensi');
  var today = todayWIB();
  var data  = sheet.getDataRange().getValues();

  var existingCheckin = '', existingCheckout = '';
  for (var i = 1; i < data.length; i++) {
    if (!data[i][0]) continue;
    var raw = data[i][0];
    var rowDate = (raw instanceof Date)
      ? Utilities.formatDate(raw, TZ, 'yyyy-MM-dd')
      : String(raw).substring(0, 10);
    if (rowDate !== today || str(data[i][1]) !== id) continue;
    var rowTipe = str(data[i][3]);
    var timePart = (raw instanceof Date)
      ? Utilities.formatDate(raw, TZ, 'HH:mm:ss')
      : String(raw).substring(11, 19);
    if (rowTipe === 'Check-In')  existingCheckin  = timePart;
    if (rowTipe === 'Check-Out') existingCheckout = timePart;
    if (rowTipe === tipe) {
      return { success: false, message: 'Anda sudah melakukan ' + tipe + ' hari ini pukul ' + timePart + ' WIB.' };
    }
  }

  var selfieUrl = saveSelfieToDrive(selfie, id, tipe);
  var now       = nowWIB();
  var timeOnly  = now.substring(11, 19);
  var link      = (latitude && longitude) ? 'https://www.google.com/maps?q=' + latitude + ',' + longitude : '';

  var statusStr = (tipe === 'Check-In')
    ? computeStatus(timeOnly, '')
    : computeStatus(existingCheckin, timeOnly);

  sheet.appendRow([now, id, nama, tipe, latitude, longitude, link, selfieUrl, inRadius, distance, statusStr]);

  return {
    success   : true,
    message   : tipe + ' berhasil dicatat. ' + (statusStr ? '(' + statusStr + ')' : ''),
    timestamp : now,
    status    : statusStr,
  };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: GET USERS (extended — return all fields)
// ════════════════════════════════════════════════════════════

function handleGetUsers(params) {
  var sh  = getSheet('Users');
  var ctx = _readUsersSheet_(sh);
  var users = [];

  for (var i = 1; i < ctx.values.length; i++) {
    var row = ctx.values[i];
    var idK = ctx.idx.id_karyawan >= 0 ? row[ctx.idx.id_karyawan] : row[0];
    if (!idK) continue;

    // tanggal_masuk: kalau cell-nya Date object, format ke YYYY-MM-DD
    var tglRaw = ctx.idx.tanggal_masuk >= 0 ? row[ctx.idx.tanggal_masuk] : '';
    var tglStr = '';
    if (tglRaw instanceof Date) {
      tglStr = Utilities.formatDate(tglRaw, TZ, 'yyyy-MM-dd');
    } else if (tglRaw) {
      tglStr = String(tglRaw).trim();
    }

    users.push({
      id_karyawan   : str(idK),
      nama          : ctx.idx.nama  >= 0 ? str(row[ctx.idx.nama])  : str(row[1]),
      email         : ctx.idx.email >= 0 ? str(row[ctx.idx.email]) : '',
      no_hp         : ctx.idx.no_hp >= 0 ? str(row[ctx.idx.no_hp]) : '',
      jabatan       : ctx.idx.jabatan >= 0 ? str(row[ctx.idx.jabatan]) : '',
      tanggal_masuk : tglStr,
      role          : (ctx.idx.role >= 0 ? str(row[ctx.idx.role]) : str(row[3])) || 'Karyawan',
      status        : (ctx.idx.status >= 0 ? str(row[ctx.idx.status]).toLowerCase() : 'active') || 'active',
    });
  }
  return { success: true, users: users };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: UPDATE USER ROLE  (legacy)
// ════════════════════════════════════════════════════════════

function handleUpdateUserRole(params) {
  var id = str(params.id_karyawan);
  var newRole = str(params.new_role);
  if (!id || !newRole) return { success: false, message: 'Parameter id_karyawan dan new_role wajib diisi.' };
  if (newRole !== 'Admin' && newRole !== 'Karyawan') return { success: false, message: 'Role tidak valid.' };

  var sh  = getSheet('Users');
  var ctx = _readUsersSheet_(sh);
  for (var i = 1; i < ctx.values.length; i++) {
    var existing = ctx.idx.id_karyawan >= 0 ? str(ctx.values[i][ctx.idx.id_karyawan]) : str(ctx.values[i][0]);
    if (existing === id) {
      var col = (ctx.idx.role >= 0 ? ctx.idx.role : 3) + 1;
      sh.getRange(i + 1, col).setValue(newRole);
      return { success: true, message: 'Role ' + id + ' berhasil diubah menjadi "' + newRole + '".' };
    }
  }
  return { success: false, message: 'Karyawan dengan ID "' + id + '" tidak ditemukan.' };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: GET TODAY ABSENSI (admin)
// ════════════════════════════════════════════════════════════

function handleGetTodayAbsensi(params) {
  var sheet = getSheet('Absensi');
  var today = (params && params.date) ? params.date : todayWIB();
  var data  = sheet.getDataRange().getValues();
  var records = [];

  for (var i = 1; i < data.length; i++) {
    var raw = data[i][0];
    if (!raw) continue;

    var rowDate, tsString;
    if (raw instanceof Date) {
      rowDate  = Utilities.formatDate(raw, TZ, 'yyyy-MM-dd');
      tsString = Utilities.formatDate(raw, TZ, 'yyyy-MM-dd HH:mm:ss');
    } else {
      rowDate  = String(raw).substring(0, 10);
      tsString = str(raw);
    }
    if (rowDate !== today) continue;

    records.push({
      timestamp   : tsString,
      id_karyawan : str(data[i][1]),
      nama        : str(data[i][2]),
      tipe_absen  : str(data[i][3]),
      latitude    : str(data[i][4]),
      longitude   : str(data[i][5]),
      link_maps   : str(data[i][6]),
      selfie_url  : str(data[i][7]),
      in_radius   : str(data[i][8]) === 'YA' ? true : (str(data[i][8]) === 'TIDAK' ? false : null),
      distance    : str(data[i][9]),
      status      : str(data[i][10]),
    });
  }
  records.sort(function (a, b) { return b.timestamp.localeCompare(a.timestamp); });
  return { success: true, records: records, today: today };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: GET ABSENSI RANGE (untuk Laporan Bulan Ini)
// ════════════════════════════════════════════════════════════

function handleGetAbsensiRange(params) {
  var from = str(params.from);
  var to   = str(params.to);
  if (!from || !to) return { success: false, message: 'Parameter from dan to wajib diisi.' };

  var sheet = getSheet('Absensi');
  var data  = sheet.getDataRange().getValues();
  var records = [];

  for (var i = 1; i < data.length; i++) {
    var raw = data[i][0];
    if (!raw) continue;

    var rowDate, tsString;
    if (raw instanceof Date) {
      rowDate  = Utilities.formatDate(raw, TZ, 'yyyy-MM-dd');
      tsString = Utilities.formatDate(raw, TZ, 'yyyy-MM-dd HH:mm:ss');
    } else {
      rowDate  = String(raw).substring(0, 10);
      tsString = str(raw);
    }
    if (rowDate < from || rowDate > to) continue;

    records.push({
      timestamp   : tsString,
      id_karyawan : str(data[i][1]),
      nama        : str(data[i][2]),
      tipe_absen  : str(data[i][3]),
      latitude    : str(data[i][4]),
      longitude   : str(data[i][5]),
      link_maps   : str(data[i][6]),
      selfie_url  : str(data[i][7]),
      in_radius   : str(data[i][8]) === 'YA' ? true : (str(data[i][8]) === 'TIDAK' ? false : null),
      distance    : str(data[i][9]),
      status      : str(data[i][10]),
    });
  }
  records.sort(function (a, b) { return b.timestamp.localeCompare(a.timestamp); });
  return { success: true, records: records, from: from, to: to };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: GET MY TODAY STATUS
// ════════════════════════════════════════════════════════════

function handleGetMyTodayStatus(params) {
  var id = str(params.id_karyawan);
  if (!id) return { success: false, message: 'ID Karyawan wajib diisi.' };

  var sheet = getSheet('Absensi');
  var today = todayWIB();
  var data  = sheet.getDataRange().getValues();
  var checkin = null, checkout = null;

  for (var i = 1; i < data.length; i++) {
    var raw = data[i][0];
    if (!raw) continue;
    var rowDate, timePart;
    if (raw instanceof Date) {
      rowDate  = Utilities.formatDate(raw, TZ, 'yyyy-MM-dd');
      timePart = Utilities.formatDate(raw, TZ, 'HH:mm:ss');
    } else {
      rowDate  = String(raw).substring(0, 10);
      timePart = String(raw).substring(11, 19);
    }
    if (rowDate !== today || str(data[i][1]) !== id) continue;
    var rowTipe = str(data[i][3]);
    if (rowTipe === 'Check-In')  checkin  = timePart;
    if (rowTipe === 'Check-Out') checkout = timePart;
  }
  return { success: true, checkin: checkin, checkout: checkout, today: today };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: GET MY MONTHLY ATTENDANCE
// ════════════════════════════════════════════════════════════

function handleGetMyMonthly(params) {
  var id    = str(params.id_karyawan);
  var year  = parseInt(params.year, 10);
  var month = parseInt(params.month, 10);
  if (!id || !year || !month) {
    return { success: false, message: 'Parameter id_karyawan, year, dan month wajib diisi.' };
  }

  var monthStr = String(month).padStart(2, '0');
  var prefix   = year + '-' + monthStr;
  var records  = {};

  var absensi = getSheet('Absensi').getDataRange().getValues();
  for (var i = 1; i < absensi.length; i++) {
    var raw = absensi[i][0];
    if (!raw) continue;
    var rowDate, timePart;
    if (raw instanceof Date) {
      rowDate  = Utilities.formatDate(raw, TZ, 'yyyy-MM-dd');
      timePart = Utilities.formatDate(raw, TZ, 'HH:mm:ss');
    } else {
      rowDate  = String(raw).substring(0, 10);
      timePart = String(raw).substring(11, 19);
    }
    if (str(absensi[i][1]) !== id || rowDate.substring(0, 7) !== prefix) continue;
    if (str(absensi[i][3]) !== 'Check-In') continue;

    var rowStat = str(absensi[i][10]);
    var status = (rowStat && rowStat.indexOf('Telat') === 0) ? 'telat' : 'hadir';
    records[rowDate] = { status: status, time: timePart };
  }

  try {
    var izinData = getSheet('Izin').getDataRange().getValues();
    for (var j = 1; j < izinData.length; j++) {
      if (!izinData[j][0]) continue;
      if (str(izinData[j][1]) !== id) continue;
      if (str(izinData[j][7]) !== 'Approved') continue;

      var izinTipe = str(izinData[j][3]).toLowerCase();
      var dari   = str(izinData[j][4]);
      var sampai = str(izinData[j][5]);
      var startDate = new Date(dari + 'T00:00:00');
      var endDate   = new Date(sampai + 'T00:00:00');
      var cur = new Date(startDate);
      while (cur <= endDate) {
        var dStr = Utilities.formatDate(cur, TZ, 'yyyy-MM-dd');
        if (dStr.substring(0, 7) === prefix && !records[dStr]) {
          records[dStr] = { status: izinTipe || 'izin' };
        }
        cur.setDate(cur.getDate() + 1);
      }
    }
  } catch (_) { /* sheet Izin belum ada — abaikan */ }

  return { success: true, records: records, year: year, month: month };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: SUBMIT IZIN
// ════════════════════════════════════════════════════════════

function handleSubmitIzin(params) {
  var id     = str(params.id_karyawan);
  var nama   = str(params.nama);
  var tipe   = str(params.tipe);
  var dari   = str(params.dari);
  var sampai = str(params.sampai);
  var alasan = str(params.alasan);

  if (!id || !nama || !tipe || !dari || !sampai || !alasan) {
    return { success: false, message: 'Semua field wajib diisi.' };
  }
  var validTipe = ['Izin', 'Sakit', 'Cuti', 'WFH'];
  if (validTipe.indexOf(tipe) === -1) return { success: false, message: 'Tipe pengajuan tidak valid.' };

  getSheet('Izin').appendRow([nowWIB(), id, nama, tipe, dari, sampai, alasan, 'Pending', '', '']);
  return { success: true, message: 'Pengajuan ' + tipe + ' berhasil dikirim. Menunggu persetujuan admin.' };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: GET MY IZIN HISTORY
// ════════════════════════════════════════════════════════════

function handleGetMyIzin(params) {
  var id = str(params.id_karyawan);
  if (!id) return { success: false, message: 'ID Karyawan wajib diisi.' };

  var data = getSheet('Izin').getDataRange().getValues();
  var records = [];
  for (var i = 1; i < data.length; i++) {
    if (!data[i][0]) continue;
    if (str(data[i][1]) !== id) continue;
    records.push({
      timestamp   : str(data[i][0]),
      id_karyawan : str(data[i][1]),
      nama        : str(data[i][2]),
      tipe        : str(data[i][3]),
      dari        : str(data[i][4]),
      sampai      : str(data[i][5]),
      alasan      : str(data[i][6]),
      status      : str(data[i][7]) || 'Pending',
    });
  }
  records.sort(function (a, b) { return b.timestamp.localeCompare(a.timestamp); });
  return { success: true, records: records };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: GET ALL IZIN (admin)
// ════════════════════════════════════════════════════════════

function handleGetAllIzin(params) {
  var data = getSheet('Izin').getDataRange().getValues();
  var records = [];
  for (var i = 1; i < data.length; i++) {
    if (!data[i][0]) continue;
    records.push({
      timestamp   : str(data[i][0]),
      id_karyawan : str(data[i][1]),
      nama        : str(data[i][2]),
      tipe        : str(data[i][3]),
      dari        : str(data[i][4]),
      sampai      : str(data[i][5]),
      alasan      : str(data[i][6]),
      status      : str(data[i][7]) || 'Pending',
      approved_by : str(data[i][8]),
      approved_at : str(data[i][9]),
    });
  }
  records.sort(function (a, b) {
    if (a.status === 'Pending' && b.status !== 'Pending') return -1;
    if (b.status === 'Pending' && a.status !== 'Pending') return 1;
    return b.timestamp.localeCompare(a.timestamp);
  });
  return { success: true, records: records };
}

// ════════════════════════════════════════════════════════════
//  HANDLER: UPDATE IZIN STATUS (admin)
// ════════════════════════════════════════════════════════════

function handleUpdateIzinStatus(params) {
  var id        = str(params.id_karyawan);
  var dari      = str(params.dari);
  var sampai    = str(params.sampai);
  var newStatus = str(params.new_status);
  var approver  = str(params.approved_by);

  if (!id || !dari || !sampai || !newStatus) return { success: false, message: 'Parameter tidak lengkap.' };
  if (newStatus !== 'Approved' && newStatus !== 'Rejected') return { success: false, message: 'Status tidak valid.' };

  var sheet = getSheet('Izin');
  var data  = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (str(data[i][1]) === id && str(data[i][4]) === dari && str(data[i][5]) === sampai) {
      sheet.getRange(i + 1, 8).setValue(newStatus);
      sheet.getRange(i + 1, 9).setValue(approver || 'Admin');
      sheet.getRange(i + 1, 10).setValue(nowWIB());
      return { success: true, message: 'Pengajuan berhasil ' + (newStatus === 'Approved' ? 'disetujui' : 'ditolak') + '.' };
    }
  }
  return { success: false, message: 'Pengajuan tidak ditemukan.' };
}

// ════════════════════════════════════════════════════════════
//  v3 HANDLER: ADD USER
// ════════════════════════════════════════════════════════════

function handleAddUser(p) {
  try {
    var idKar    = str(p.id_karyawan);
    var nama     = str(p.nama);
    var email    = str(p.email);
    var noHp     = str(p.no_hp);
    var jabatan  = str(p.jabatan);
    var tglMasuk = str(p.tanggal_masuk);
    var role     = str(p.role) || 'Karyawan';
    var pin      = str(p.pin);

    if (!idKar || !nama) return { success: false, message: 'ID Karyawan dan Nama wajib diisi.' };
    if (!pin || !/^\d{4,6}$/.test(pin)) return { success: false, message: 'PIN default harus 4-6 digit angka.' };

    var sh = getSheet('Users');
    _ensureUsersColumns_(sh);          // pastikan kolom email/no_hp/jabatan/tanggal_masuk/status sudah ada
    var ctx = _readUsersSheet_(sh);

    for (var i = 1; i < ctx.values.length; i++) {
      var existing = ctx.idx.id_karyawan >= 0 ? str(ctx.values[i][ctx.idx.id_karyawan]) : str(ctx.values[i][0]);
      if (existing === idKar) {
        return { success: false, message: 'ID "' + idKar + '" sudah terdaftar.' };
      }
    }

    var lastCol = sh.getLastColumn();
    var row = new Array(lastCol).fill('');
    _setCol_(row, ctx.idx, 'id_karyawan',   idKar);
    _setCol_(row, ctx.idx, 'nama',          nama);
    _setCol_(row, ctx.idx, 'pin',           pin);
    _setCol_(row, ctx.idx, 'role',          role);
    _setCol_(row, ctx.idx, 'email',         email);
    _setCol_(row, ctx.idx, 'no_hp',         noHp);
    _setCol_(row, ctx.idx, 'jabatan',       jabatan);
    _setCol_(row, ctx.idx, 'tanggal_masuk', tglMasuk);
    _setCol_(row, ctx.idx, 'status',        'active');
    sh.appendRow(row);

    return { success: true, message: 'Karyawan ditambahkan.' };
  } catch (e) {
    return { success: false, message: 'Gagal: ' + (e && e.message ? e.message : e) };
  }
}

// ════════════════════════════════════════════════════════════
//  v3 HANDLER: UPDATE USER
// ════════════════════════════════════════════════════════════

function handleUpdateUser(p) {
  try {
    var idKar = str(p.id_karyawan);
    if (!idKar) return { success: false, message: 'ID Karyawan wajib diisi.' };

    var sh = getSheet('Users');
    _ensureUsersColumns_(sh);
    var ctx = _readUsersSheet_(sh);

    var rowNum = -1;
    for (var i = 1; i < ctx.values.length; i++) {
      var existing = ctx.idx.id_karyawan >= 0 ? str(ctx.values[i][ctx.idx.id_karyawan]) : str(ctx.values[i][0]);
      if (existing === idKar) { rowNum = i + 1; break; }
    }
    if (rowNum < 0) return { success: false, message: 'Karyawan "' + idKar + '" tidak ditemukan.' };

    var fields = ['nama', 'email', 'no_hp', 'jabatan', 'tanggal_masuk', 'role'];
    fields.forEach(function (k) {
      if (p[k] !== undefined && p[k] !== null && ctx.idx[k] >= 0) {
        sh.getRange(rowNum, ctx.idx[k] + 1).setValue(p[k]);
      }
    });

    if (p.pin && /^\d{4,6}$/.test(String(p.pin)) && ctx.idx.pin >= 0) {
      sh.getRange(rowNum, ctx.idx.pin + 1).setValue(String(p.pin));
    }
    return { success: true, message: 'Data karyawan diperbarui.' };
  } catch (e) {
    return { success: false, message: 'Gagal: ' + (e && e.message ? e.message : e) };
  }
}

// ════════════════════════════════════════════════════════════
//  v3 HANDLER: SET USER STATUS
// ════════════════════════════════════════════════════════════

function handleSetUserStatus(p) {
  try {
    var idKar = str(p.id_karyawan);
    var st    = str(p.status).toLowerCase();
    if (!idKar) return { success: false, message: 'ID Karyawan wajib diisi.' };
    if (st !== 'active' && st !== 'inactive') return { success: false, message: 'Status harus active atau inactive.' };

    var sh = getSheet('Users');
    _ensureUsersColumns_(sh);
    var ctx = _readUsersSheet_(sh);
    if (ctx.idx.status < 0) return { success: false, message: 'Kolom status tidak ada di sheet Users.' };

    for (var i = 1; i < ctx.values.length; i++) {
      var existing = ctx.idx.id_karyawan >= 0 ? str(ctx.values[i][ctx.idx.id_karyawan]) : str(ctx.values[i][0]);
      if (existing === idKar) {
        sh.getRange(i + 1, ctx.idx.status + 1).setValue(st);
        return { success: true, message: st === 'inactive' ? 'Karyawan dinonaktifkan.' : 'Karyawan diaktifkan.' };
      }
    }
    return { success: false, message: 'Karyawan "' + idKar + '" tidak ditemukan.' };
  } catch (e) {
    return { success: false, message: 'Gagal: ' + (e && e.message ? e.message : e) };
  }
}

// ════════════════════════════════════════════════════════════
//  v3 HANDLER: RESET PIN
// ════════════════════════════════════════════════════════════

function handleResetPin(p) {
  try {
    var idKar = str(p.id_karyawan);
    if (!idKar) return { success: false, message: 'ID Karyawan wajib diisi.' };

    var sh = getSheet('Users');
    _ensureUsersColumns_(sh);
    var ctx = _readUsersSheet_(sh);
    if (ctx.idx.pin < 0) return { success: false, message: 'Kolom PIN tidak ada di sheet Users.' };

    var rowNum = -1, namaUser = idKar, emailUser = '';
    for (var i = 1; i < ctx.values.length; i++) {
      var existing = ctx.idx.id_karyawan >= 0 ? str(ctx.values[i][ctx.idx.id_karyawan]) : str(ctx.values[i][0]);
      if (existing === idKar) {
        rowNum    = i + 1;
        namaUser  = ctx.idx.nama  >= 0 ? str(ctx.values[i][ctx.idx.nama])  : str(ctx.values[i][1]);
        emailUser = ctx.idx.email >= 0 ? str(ctx.values[i][ctx.idx.email]) : '';
        break;
      }
    }
    if (rowNum < 0) return { success: false, message: 'Karyawan "' + idKar + '" tidak ditemukan.' };

    var newPin = String(Math.floor(100000 + Math.random() * 900000));
    sh.getRange(rowNum, ctx.idx.pin + 1).setValue(newPin);

    var sentEmail = false;
    if (emailUser) {
      try {
        MailApp.sendEmail({
          to: emailUser,
          subject: 'PIN Absensi FSR Anda Telah Direset',
          body: 'Halo ' + namaUser + ',\n\nPIN Absensi FSR Anda telah direset oleh admin.\nPIN baru: ' + newPin + '\n\nMohon segera login dan ubah PIN Anda jika perlu.',
        });
        sentEmail = true;
      } catch (mailErr) { /* MailApp belum di-authorize — abaikan, tetap return success */ }
    }

    return {
      success: true,
      message: sentEmail ? 'PIN direset dan dikirim ke email.' : 'PIN direset. Silakan informasikan ke karyawan.',
      new_pin: newPin,
    };
  } catch (e) {
    return { success: false, message: 'Gagal: ' + (e && e.message ? e.message : e) };
  }
}

